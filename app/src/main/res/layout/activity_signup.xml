<?xml version="1.0" encoding="utf-8"?>
<!-- New User (sign up) -->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="72dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/join_bookmarked"
            android:textColor="@color/text_on_dark"
            android:textSize="32sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/please_fill_in_info"
            android:textColor="@color/accent_teal"
            android:textSize="@dimen/text_body"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                style="@style/BookMarked.FieldLabel"
                android:labelFor="@+id/et_signup_username"
                android:text="@string/username"/>

            <EditText
                android:id="@+id/et_signup_username"
                android:layout_width="179dp"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="@string/username"
                android:inputType="text"
                style="@style/BookMarked.Input"
                android:textColorHint="@color/black" />

            <TextView
                style="@style/BookMarked.FieldLabel"
                android:labelFor="@+id/et_signup_email"
                android:text="@string/email"/>

            <EditText
                android:id="@+id/et_signup_email"
                android:layout_width="179dp"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                style="@style/BookMarked.Input"
                android:textColorHint="@color/black" />

            <TextView
                style="@style/BookMarked.FieldLabel"
                android:labelFor="@+id/et_signup_password"
                android:text="@string/password"/>

            <EditText
                android:id="@+id/et_signup_password"
                android:layout_width="177dp"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/password"
                android:inputType="textPassword"
                style="@style/BookMarked.Input"
                android:textColorHint="@color/black" />

            <TextView
                style="@style/BookMarked.FieldLabel"
                android:labelFor="@+id/et_signup_confirm_password"
                android:text="@string/confirm_password"/>

            <EditText
                android:id="@+id/et_signup_confirm_password"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/password"
                android:inputType="textPassword"
                style="@style/BookMarked.Input"
                android:textColorHint="@color/black" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_signup"
            style="@style/BookMarked.PillButton"
            android:layout_marginTop="48dp"
            android:textAlignment="center"
            android:text="@string/sing_up"/>


    </LinearLayout>

</ScrollView>