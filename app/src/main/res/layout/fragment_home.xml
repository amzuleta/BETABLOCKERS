<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_home_header"
        style="@style/BookMarked.Header"
        tools:text="Welcome back, Ailed"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_home_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_teal"
                        android:textSize="32sp"
                        tools:text="7"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingMultiplier="0.9"
                        android:text="@string/day_streak"
                        android:textColor="@color/accent_teal"
                        android:textSize="@dimen/text_body"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_home_goal_title"
                        android:textColor="@color/accent_teal"
                        android:textSize="@dimen/text_section"
                        tools:text="reading goal:20 books"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/BookMarked.Progress"
                        android:id="@+id/progress_home_goal"
                        android:layout_marginTop="8dp"
                        android:max="20"
                        tools:progress="4"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:id="@+id/tv_home_books_read"
                        android:textColor="@color/text_on_dark"
                        android:textSize="@dimen/text_small"
                        tools:text="4 books read"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/card_currently_reading"
                android:layout_marginStart="24dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/BookMarked.SectionTitle"
                    android:text="@string/currently_reading"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/cover_width_large"
                        android:layout_height="@dimen/cover_height_large"
                        android:id="@+id/iv_home_current_cover"
                        android:contentDescription="@string/book_cover_description"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_cover_placeholder"
                        app:shapeAppearanceOverlay="@style/BookMarked.CoverShape"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_home_current_title"
                            android:textColor="@color/text_on_dark"
                            android:textSize="@dimen/text_section"
                            tools:text="dune"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_home_current_author"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_on_dark"
                            android:textSize="14sp"
                            tools:text="Frank Herbert"/>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/progress_home_chapter"
                            style="@style/BookMarked.Progress"
                            android:layout_marginTop="16dp"
                            tools:max="22"
                            tools:progress="14"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_home_current_chapter"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_on_dark"
                            android:textSize="@dimen/text_small"
                            tools:text="Chapter 14"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@color/nav_background"
                android:minHeight="300dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/BookMarked.SectionTitle"
                    android:layout_marginStart="20dp"
                    android:text="@string/my_book_club_updates"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_home_club_updates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_club_update"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
