<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:background="@drawable/bg_card_blue"
    android:gravity="center_vertical"
    android:minHeight="100dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="16dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:id="@+id/iv_achievement_icon"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_trophy"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_achievement_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="15 books completed!"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_achievement_subtitle"
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="15sp"
            tools:text="You've read 15 books"/>


    </LinearLayout>


</LinearLayout>