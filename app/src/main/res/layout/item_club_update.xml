<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:background="@drawable/bg_card_blue"
    android:foreground="?selectableItemBackground"
    android:minHeight="90dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_update_title"
        android:textColor="@color/white"
        android:textSize="@dimen/text_body"
        tools:text="Fantasy readers - voting open"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_update_body"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_on_dark_secondary"
        android:textSize="15sp"
        tools:text="members please vote for the next book"/>
</LinearLayout>