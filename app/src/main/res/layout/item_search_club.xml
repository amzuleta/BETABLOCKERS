<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_teal"
            android:id="@+id/tv_search_club_name"
            android:textSize="@dimen/text_section"
            android:layout_marginStart="10dp"
            tools:text="Harry potter Lovers"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_dark_secondary"
            android:id="@+id/tv_search_club_members"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            android:textSize="14sp"
            tools:text="8 members"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_club_inner"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_book"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/cover_width_small"
                    android:layout_height="@dimen/cover_height_small"
                    android:id="@+id/iv_search_club_cover"
                    android:contentDescription="@string/book_cover_description"
                    android:scaleType="centerCrop"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_search_club_book_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body"
                        tools:text="Harry Potter and the chamber of secrets"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_search_club_book_author"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body"
                        tools:text="J.K.Rowling"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_search_join_club"
                        style="@style/BookMarked.TealButton"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="@string/join_club"/>


                </LinearLayout>

            </LinearLayout>

    </LinearLayout>

</LinearLayout>