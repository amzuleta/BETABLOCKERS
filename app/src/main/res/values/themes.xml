<?xml version="1.0" encoding="UTF-8" ?>

<resources>
    <style name="Theme.BookMarked" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/navy_card</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/text_on_light</item>
        <item name="android:windowBackground">@color/navy_background</item>
        <item name="android:statusBarColor">@color/navy_card</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="BookMarked" parent=""/>

    <style name="BookMarked.Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/header_height</item>
        <item name="android:background">@color/header_gray</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_on_light</item>
        <item name="android:textSize">@dimen/text_header</item>
    </style>

    <style name="BookMarked.SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/accent_teal</item>
        <item name="android:textSize">@dimen/text_section</item>
    </style>

    <style name="BookMarked.FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="BookMarked.Input">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text_on_light</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="BookMarked.PillButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">@dimen/pill_button_wdith</item>
        <item name="android:layout_height">@dimen/pill_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="background">@color/accent_blue</item>
        <item name="cornerRadius">27dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="BookMarked.TealButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_on_light</item>
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="cornerRadius">22dp</item>
        <item name="icon">@drawable/ic_add</item>
        <item name="iconSize">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="BookMarked.ToggleButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/toggle_background</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="BookMarked.CoverShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="BookMarked.Progress" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="trackThickness">14dp</item>
        <item name="trackCornerRadius">7dp</item>
        <item name="indicatorColor">@color/accent_blue</item>
        <item name="trackColor">@color/progress_track</item>
    </style>
</resources>